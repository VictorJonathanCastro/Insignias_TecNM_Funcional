{
    "name": "tecnm\/insignias-sistema",
    "description": "Sistema de Insignias Digitales TecNM",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpoffice\/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "TecNM\\Insignias\\": "src\/"
        }
    },
    "config": {
        "disable-tls": true,
        "secure-http": false
    },
    "repositories": [
        {
            "type": "composer",
            "url": "http://repo.packagist.org"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}